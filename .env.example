# ─────────────────────────────────────────────────────────────────────────────
# RadarJob configuration. Copy to `.env` in the repository root:  cp .env.example .env
# The API reads this file in development. Never commit real credentials.
# Education guides and the quiz work with NONE of the keys below.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Browser origin(s) allowed by CORS (comma-separated). The web app normally calls the API
# through its own /api rewrite, so this matters only for direct cross-origin access.
FRONTEND_URL=http://localhost:3000
# Express "trust proxy". "loopback" trusts X-Forwarded-For only from the local Next.js server.
TRUST_PROXY=loopback
# "json" for structured production logs, "pretty" for development.
LOG_FORMAT=pretty

# ── Persistence (optional) ───────────────────────────────────────────────────
# Without DATABASE_URL, reports are kept in memory and lost on restart.
# With docker compose:  postgresql://radarjob:radarjob@localhost:5432/radarjob
DATABASE_URL=
# Server-side reports are deleted after this many hours.
REPORT_RETENTION_HOURS=72

# ── VirusTotal (URL reputation) ──────────────────────────────────────────────
# Free key: https://www.virustotal.com/gui/join-us  (public API: 4 requests/minute, 500/day)
VIRUSTOTAL_API_KEY=replace-with-your-virustotal-key
VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# Reuse an existing VirusTotal report if it is newer than this; otherwise request a new scan.
VIRUSTOTAL_MAX_REPORT_AGE_DAYS=7
VIRUSTOTAL_POLL_ATTEMPTS=3
VIRUSTOTAL_POLL_INTERVAL_MS=15000
VIRUSTOTAL_CACHE_TTL_MINUTES=60
VIRUSTOTAL_TIMEOUT_MS=15000

# ── Domain intelligence ──────────────────────────────────────────────────────
# rdap     = free, keyless IETF standard via the IANA bootstrap (default). Some ccTLDs (incl. .ke) may not publish RDAP.
# whoisxml = WhoisXML API (paid, broader coverage) — https://whois.whoisxmlapi.com
# none     = disabled (reports show "not configured")
DOMAIN_INTELLIGENCE_PROVIDER=rdap
DOMAIN_INTELLIGENCE_API_KEY=
DOMAIN_INTELLIGENCE_TIMEOUT_MS=10000

# ── AI provider (optional) ───────────────────────────────────────────────────
# anthropic | openai | none. Without AI, deterministic rules and templates are used.
AI_PROVIDER=none
# Defaults to claude-haiku-5-5 for Anthropic. Required for openai-compatible providers.
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000

# ── Safe page inspection ─────────────────────────────────────────────────────
# Fetches the submitted page once (no JavaScript, no forms) through an SSRF guard.
# Off by default. Before enabling in production, also run the API in a network
# segment with no route to internal services (see README › Security).
PAGE_INSPECTION_ENABLED=false
PAGE_INSPECTION_TIMEOUT_MS=8000
PAGE_INSPECTION_MAX_BYTES=1000000
PAGE_INSPECTION_MAX_REDIRECTS=5

# ── Abuse protection ─────────────────────────────────────────────────────────
ANALYSIS_RATE_LIMIT_PER_HOUR=20
ANALYSIS_MAX_CONCURRENT=4
ANALYSIS_MAX_QUEUED=20
ANALYSIS_TIMEOUT_MS=120000

# ── Development only ─────────────────────────────────────────────────────────
# Deterministic fake providers; every report is labelled SIMULATED. Refused when NODE_ENV=production.
DEV_MOCK_PROVIDERS=false

# ── Web app (apps/web) ───────────────────────────────────────────────────────
# Read by Next.js from apps/web/.env.local (copy these two lines there if you change them).
# Where the Next.js server forwards /api/* — server-side only, never sent to the browser.
API_INTERNAL_URL=http://127.0.0.1:4000
# Optional public contact address shown on the About page.
CONTACT_EMAIL=
